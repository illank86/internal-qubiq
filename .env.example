# Copy to .env.local (git-ignored) and fill in.
#
# The same Supabase project as the website. Only the publishable key: every
# read and write is checked by the database's row-level security, exactly as
# in the website's /admin. Never put a service-role or secret key here — it
# would ship to every browser that loads the app.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public website, for links to customer pages and PDFs.
VITE_SITE_URL=https://goqubiq.com
